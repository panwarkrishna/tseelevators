# ============================================
# .htaccess for tseelevators.com
# Next.js static export (output: 'export', trailingSlash: false)
# Lives in /public so it is copied into /out on every build.
# Clean URLs, no trailing slash:  /contact  (not /contact/)
# ============================================

Options -Indexes
DirectoryIndex index.html

# IMPORTANT: stops Apache redirecting /contact -> /contact/ when a folder
# named "contact" exists. That redirect is what caused the 403 Forbidden.
DirectorySlash Off

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ---- www -> non-www + HTTPS in a single hop ----
RewriteCond %{HTTP_HOST} ^www\.tseelevators\.com$ [NC]
RewriteRule ^(.*)$ https://tseelevators.com/$1 [L,R=301]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://tseelevators.com/$1 [L,R=301]

# ---- Bypass all Next.js rules for the WordPress /blogsite folder ----
# Let public_html/blogsite/.htaccess (WordPress's own rules) handle it.
RewriteRule ^blogsite(/.*)?$ - [L]

# ---- Old / mistyped URLs -> current pages (301) ----
RewriteRule ^blog001/?$ /blog [L,R=301]
RewriteRule ^(commercial|domestic|glass|goods|hydraulic)-lifts/?$ /$1-lift [L,R=301]

# ---- 1. Remove trailing slash: /contact/ -> /contact (301) ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [L,R=301]

# ---- 2. Serve /contact from contact.html ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ---- 3. Fallback: serve /folder from folder/index.html if it exists ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Caching for static assets ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
