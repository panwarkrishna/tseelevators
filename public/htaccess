# ============================================
# .htaccess for tseelevators.com
# Next.js static export (output: 'export')
# Explicit rules generated from sitemap.xml
# ============================================

RewriteEngine On

# ---- Force HTTPS ----
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- Force non-www (canonical domain) ----
RewriteCond %{HTTP_HOST} ^www\.tseelevators\.com [NC]
RewriteRule ^(.*)$ https://tseelevators.com/$1 [L,R=301]

# ---- Explicit clean-URL rules (from sitemap.xml) ----
RewriteRule ^about/?$ about.html [L]
RewriteRule ^products/?$ products.html [L]
RewriteRule ^home-lift/?$ home-lift.html [L]
RewriteRule ^domestic-lift/?$ domestic-lift.html [L]
RewriteRule ^residential-lift/?$ residential-lift.html [L]
RewriteRule ^passenger-lift/?$ passenger-lift.html [L]
RewriteRule ^commercial-lift/?$ commercial-lift.html [L]
RewriteRule ^pitless-lift/?$ pitless-lift.html [L]
RewriteRule ^goods-lift/?$ goods-lift.html [L]
RewriteRule ^glass-lift/?$ glass-lift.html [L]
RewriteRule ^hydraulic-lift/?$ hydraulic-lift.html [L]
RewriteRule ^services/?$ services.html [L]
RewriteRule ^lift-installation-services/?$ lift-installation-services.html [L]
RewriteRule ^lift-repair-services/?$ lift-repair-services.html [L]
RewriteRule ^lift-maintenance-services/?$ lift-maintenance-services.html [L]
RewriteRule ^lift-amc-services/?$ lift-amc-services.html [L]
RewriteRule ^lift-dismantling-services/?$ lift-dismantling-services.html [L]
RewriteRule ^lift-ms-structure/?$ lift-ms-structure.html [L]
RewriteRule ^luxury-elevator/?$ luxury-elevator.html [L]
RewriteRule ^customized-elevator/?$ customized-elevator.html [L]
RewriteRule ^gallery/?$ gallery.html [L]
RewriteRule ^blog001/?$ blog001.html [L]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^certificate-of-appreciation/?$ certificate-of-appreciation.html [L]
RewriteRule ^electrical-license/?$ electrical-license.html [L]

# ---- Fallback: any other request, try matching .html file directly ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# ---- Remove trailing slash (matches trailingSlash: false) ----
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]

# ---- Custom 404 page (optional - only if out/404.html exists) ----
ErrorDocument 404 /404.html

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Caching for static assets ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Note: No sitemap redirect rules here on purpose.
# sitemap.xml and robots.txt are served directly as static files
# from the exported /out folder - no rewrite needed for them.
